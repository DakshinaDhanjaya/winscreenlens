# Primary target language: Sinhala (සිංහල)
TARGET_LANGUAGE=Sinhala

# Primary screen/video translation engine: 'google' (direct Google Translate, free, ultra-fast)
TRANSLATION_ENGINE=google

# ==============================================================================
# AI Provider for Slang / Idiom / Indirect Meaning Explanations
# Options: 'gemini', 'groq', 'openrouter', 'openai'
# ==============================================================================
AI_PROVIDER=gemini

# 1. Google Gemini (Active & Verified):
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

# 2. Groq (Optional - 100% Free at https://console.groq.com/):
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 3. OpenRouter (Free models at https://openrouter.ai/):
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 4. OpenAI (ChatGPT at https://platform.openai.com/):
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ==============================================================================
# Performance & Overlay Tuning
# ==============================================================================
LIVE_INTERVAL_MS=450
FRAME_DIFF_THRESHOLD=0.015
OVERLAY_OPACITY=220
